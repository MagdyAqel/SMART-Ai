rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // محتوى الدورات: يقرؤه كل مستخدم مسجّل، ويكتبه المشرف فقط
    // (الدوال السحابية تكتب عبر Admin SDK فتتجاوز هذه القواعد).
    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ملف تقدّم المتدرب: يخصّ صاحبه فقط.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0;
      allow delete: if false;

      // سجل المحاولات: إضافة وقراءة فقط.
      match /attempts/{attemptId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      // الاختبارات المولّدة بالذكاء الاصطناعي: تكتبها الدوال السحابية فقط.
      match /quizzes/{quizId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // لوحة الصدارة: يقرؤها الجميع، وكل متدرب يحدّث سطره فقط.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'xp', 'level', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.xp is int
        && request.resource.data.level is int;
      allow delete: if isOwner(uid);
    }

    // عدّاد استهلاك الذكاء الاصطناعي: للخادم فقط.
    match /usage/{docId} {
      allow read, write: if false;
    }
  }
}
