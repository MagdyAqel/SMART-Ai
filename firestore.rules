rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // الخطة المجانية (بلا دوال سحابية): يُصحَّح الاختبار البعدي في المتصفح.
    function freeMode() {
      return get(/databases/$(database)/documents/settings/platform).data.get('freeMode', false) == true;
    }

    // التسجيل الذاتي (حساب جديد من صفحة الدخول): يغلقه المشرف من لوحة التحكم،
    // فلا يُنشئ ملفاً في المنصة إلا من أضافه المشرف.
    function signupOpen() {
      return !exists(/databases/$(database)/documents/settings/public)
        || get(/databases/$(database)/documents/settings/public).data.get('auth', {}).get('signup', true) == true;
    }

    // محتوى الدورات: يقرؤه كل مستخدم مسجّل، ويكتبه المشرف فقط
    // (الدوال السحابية تكتب عبر Admin SDK فتتجاوز هذه القواعد).
    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // مفاتيح إجابات الاختبار البعدي: لا يقرؤها المتدرب، ويصحّح بها الخادم.
    match /courseKeys/{courseId} {
      allow read: if isAdmin() || (signedIn() && freeMode());
      allow write: if isAdmin();
    }

    // إعدادات المنصة (مثل نسبة النجاح للانتقال): يقرؤها الجميع ويعدّلها المشرف.
    match /settings/{docId} {
      // settings/public: طرق الدخول المتاحة، تقرؤها صفحة الدخول قبل تسجيل الدخول
      allow read: if signedIn() || docId == 'public';
      allow write: if isAdmin();
    }

    // ملف تقدّم المتدرب: يخصّ صاحبه فقط.
    match /users/{uid} {
      // المشرف يقرأ ملفات المتدربين للتقارير وملف Excel، وينشئ حسابات المتدربين ويعدّلها
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isAdmin();
      // نتائج المهام (tasks) والاختبارات البعدية (postTests) يكتبها الخادم فقط.
      allow create: if isOwner(uid)
        && signupOpen()
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && !('tasks' in request.resource.data)
        && !('postTests' in request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tasks'])
        && (freeMode() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['postTests']));
      allow delete: if false;

      // محاولات الاختبار البعدي: يكتبها الخادم، ويقرؤها صاحبها.
      match /postTestAttempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      // تسليمات المهام ودرجاتها: يكتبها الخادم، ويقرؤها صاحبها.
      match /submissions/{submissionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      // سجل المحاولات: إضافة وقراءة فقط.
      match /attempts/{attemptId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      // الاختبارات المولّدة بالذكاء الاصطناعي: تكتبها الدوال السحابية فقط.
      match /quizzes/{quizId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // لوحة الصدارة: يقرؤها الجميع، وكل متدرب يحدّث سطره فقط.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'xp', 'level', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.xp is int
        && request.resource.data.level is int;
      allow delete: if isOwner(uid);
    }

    // عدّاد استهلاك الذكاء الاصطناعي: للخادم فقط.
    match /usage/{docId} {
      allow read, write: if false;
    }
  }
}
